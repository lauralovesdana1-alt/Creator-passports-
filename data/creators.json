const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;
const DATA_FILE = path.join(__dirname, 'data', 'creators.json');

const DEFAULT_CREATORS = [
  {
    id: 'creator-dana-20391',
    name: 'Dana Reed',
    githubUsername: 'lauralovesdana1-alt',
    bio: 'Builds developer tools, growth systems, and elegant product experiences.',
    skills: ['React', 'Node', 'UX', 'GitHub API'],
    verified: true
  },
  {
    id: 'creator-oliver-40198',
    name: 'Oliver Grant',
    githubUsername: 'olivergrant',
    bio: 'Platform engineer focused on open-source tooling and scalable internal APIs.',
    skills: ['Go', 'DevOps', 'Kubernetes', 'CI/CD'],
    verified: true
  },
  {
    id: 'creator-sanya-78501',
    name: 'Sanya Patel',
    githubUsername: 'sanyapatel',
    bio: 'Designs developer experiences and product architecture for creator communities.',
    skills: ['TypeScript', 'Design Systems', 'Frontend', 'AI'],
    verified: false
  },
  {
    id: 'creator-jamie-90317',
    name: 'Jamie Collins',
    githubUsername: 'jamiecollins',
    bio: 'Shipping developer experiences that combine performance, trust, and clarity.',
    skills: ['Rust', 'Systems', 'Performance', 'Security'],
    verified: true
  }
];

function ensureDataFile() {
  const dir = path.dirname(DATA_FILE);

  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }

  if (!fs.existsSync(DATA_FILE)) {
    fs.writeFileSync(DATA_FILE, JSON.stringify(DEFAULT_CREATORS, null, 2));
  }
}

function readCreators() {
  ensureDataFile();
  const raw = fs.readFileSync(DATA_FILE, 'utf8');
  const parsed = JSON.parse(raw);
  return Array.isArray(parsed) ? parsed : DEFAULT_CREATORS;
}

function writeCreators(creators) {
  ensureDataFile();
  fs.writeFileSync(DATA_FILE, JSON.stringify(creators, null, 2));
}

function generateCreatorId(username) {
  const cleanName = (username || 'developer')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '')
    .slice(0, 12) || 'developer';

  const suffix = Math.random().toString(36).slice(2, 7);
  return `creator-${cleanName}-${suffix}`;
}

app.use(express.json());
app.use(express.static(__dirname));

app.get('/api/creators', (req, res) => {
  const creators = readCreators();
  res.json(creators);
});

app.post('/api/creators', (req, res) => {
  const { name, githubUsername, bio, skills, verified } = req.body || {};

  if (!name || !githubUsername || !Array.isArray(skills) || !skills.length) {
    return res.status(400).json({ message: 'Name, GitHub username, and skills are required.' });
  }

  const creators = readCreators();
  const newCreator = {
    id: generateCreatorId(githubUsername),
    name: String(name).trim(),
    githubUsername: String(githubUsername).trim(),
    bio: String(bio || 'Developer building meaningful experiences for the open web.'),
    skills: skills.map((skill) => String(skill).trim()).filter(Boolean),
    verified: Boolean(verified)
  };

  const nextCreators = [newCreator, ...creators];
  writeCreators(nextCreators);
  res.status(201).json(nextCreators);
});

app.post('/api/reset', (req, res) => {
  writeCreators(DEFAULT_CREATORS);
  res.json(DEFAULT_CREATORS);
});

app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

app.listen(PORT, () => {
  console.log(`Creator passports app running on http://localhost:${PORT}`);
});
